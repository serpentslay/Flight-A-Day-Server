# Copy to .env for Docker Compose. Local cargo commands use shell environment variables.
FLIGHT_PUBLISH_ENABLED=false
FLIGHT_PUBLISH_BACKEND=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=flight-a-day
R2_PUBLIC_BASE_URL=https://display.example.com
# Recommended: place the two credential values in these host files.
# Ensure UID 10001 can read them. Never commit the files.
R2_ACCESS_KEY_ID_FILE=/run/secrets/r2-access-key-id
R2_SECRET_ACCESS_KEY_FILE=/run/secrets/r2-secret-access-key
